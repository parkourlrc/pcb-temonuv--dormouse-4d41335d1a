# SDK-generated project (recreate with tools/build.sh)
/build/
/build_test/
/generated/
/gecko_sdk_*/
/simplicity_sdk_*/

# Build artifacts
*.o
*.d
*.out
*.axf
*.map
*.s37
*.hex
*.bin

# Simplicity Studio / SLC local state
# autogen/ holds machine-generated .slconf output (absolute install paths +
# conan hashes) — regenerated by `slt install`; the build resolves the toolchain
# live via `slt where` (tools/env.sh), so it must NOT be committed.
.slps
.projectlinkstore/
autogen/
.settings/
.cproject
.project

# KiCad backups / caches (keep .kicad_sch/.kicad_pro/.py/.pdf/.csv sources)
*-backups/
*.kicad_sch-bak
*.kicad_pro-bak
*_autosave-*
fp-info-cache
*.kicad_prl

# KiCad routing/report exchange files — regenerable, see hardware/README.md.
# NOTE: .gitignore has no inline comments — keep patterns on their own lines.
*.dsn
*.ses
hardware/*.rpt
hardware/mgm210l_sensor.net
hardware/mgm210l_sensor_drc_violations.json
hardware/mgm210l_sensor_bom.csv
hardware/fab/*.zip

# Vendor datasheets — third-party copyright, linked from docs/hardware.md not vendored
hardware/mgm210l-datasheet.pdf
hardware/Sensirion_Datasheet_SHT4x.pdf

# Editor / OS / local agent state
.vscode/
.idea/
.claude/
*.swp
.DS_Store
